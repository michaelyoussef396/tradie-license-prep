{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/email-templates",
      "destination": "/admin/email-templates",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/thank-you", "destination": "/spa" },
    { "source": "/dashboard", "destination": "/spa" },
    { "source": "/admin", "destination": "/spa" },
    { "source": "/admin/:path*", "destination": "/spa" }
  ]
}
